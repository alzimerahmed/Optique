<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Purged face thumbnails must not be resurrected by a restore (KTD4). -->
        <exclude domain="file" path="face_thumbs/"/>
    </cloud-backup>
    <device-transfer>
        <!-- Purged face thumbnails must not be resurrected by a transfer (KTD4). -->
        <exclude domain="file" path="face_thumbs/"/>
    </device-transfer>
</data-extraction-rules>
